{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "mutate": [
    "src/domain/calculo.ts",
    "src/domain/validacao.ts",
    "src/domain/moeda.ts",
    "src/domain/datas.ts",
    "src/domain/rescisao.ts"
  ],
  "reporters": [
    "clear-text",
    "json",
    "html"
  ],
  "jsonReporter": {
    "fileName": "reports/mutacao/mutation.json"
  },
  "htmlReporter": {
    "fileName": "reports/mutacao/index.html"
  },
  "coverageAnalysis": "perTest",
  "thresholds": {
    "high": 90,
    "low": 75,
    "break": 70
  },
  "tsconfigFile": "tsconfig.stryker-inexistente.json"
}
