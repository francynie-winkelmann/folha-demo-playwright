{
  "name": "folha-demo-playwright",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sistema de folha de pagamento FICTÍCIO, com defeitos propositais, para demonstrar testes automatizados com Playwright.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "oraculos:gerar": "tsx scripts/gerar-casos.ts && tsx scripts/gerar-casos-rescisao.ts",
    "defeitos:medir": "tsx scripts/medir-defeitos.ts",
    "test:unit": "vitest run",
    "mutacao": "stryker run",
    "rastreabilidade": "tsx scripts/gerar-rastreabilidade.ts",
    "instabilidade": "tsx scripts/medir-instabilidade.ts",
    "evidencia": "tsx scripts/gerar-evidencia.ts",
    "regressao": "tsx scripts/regressao.ts",
    "regressao:referencia": "tsx scripts/regressao-referencia.ts",
    "test:bdd": "bddgen -c playwright.bdd.config.ts && playwright test -c playwright.bdd.config.ts",
    "defeitos:relatar": "tsx scripts/gerar-relatos-defeitos.ts",
    "site": "tsx scripts/gerar-site.ts"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "playwright-bdd": "^9.2.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
